# Allow list: everything is ignored unless its path is listed below.
*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/pyproject.toml
!/uv.lock
!/gui.bat
!/demo/
!/demo/*.py
!/demo/*.bat
!/src/
!/src/officetext/
!/src/officetext/*.py
!/src/officetext/*.md
!/src/officetext/tests/
!/src/officetext/tests/*.py
!/src/watchpoint/
!/src/watchpoint/*.py
!/src/watchpoint/*.html
!/src/watchpoint/*.css
!/src/watchpoint/*.js
!/src/watchpoint/fetchers/
!/src/watchpoint/fetchers/*.py
!/src/watchpoint/textify/
!/src/watchpoint/textify/*.py
!/src/watchpoint/cli/
!/src/watchpoint/cli/*.py
!/src/watchpoint/skill/
!/src/watchpoint/skill/*.md
!/tests/
!/tests/*.py
!/docs/
!/docs/*.md

# Never publish, even under an allowed path.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
secrets.json
credentials.json
credentials.toml
targets.yaml
log.jsonl
state.json
